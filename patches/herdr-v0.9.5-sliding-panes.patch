@@ -0,0 +1,568 @@
+//! A client-local horizontal viewport over the existing tiled terminal surface.
+use super::*;
+use crossterm::event::{KeyModifiers, MouseEvent, MouseEventKind};
+use ratatui::style::Color;
+
+const PANE_COLUMNS: u16 = 96;
+const SCROLL_COLUMNS: i32 = 8;
+
+#[derive(Default)]
+pub(super) struct SlidingPanes {
+    pub enabled: bool,
+    pub offset: u16,
+    pub(super) reveal_key: Option<(ClientEndpointId, String, u16, u16)>,
+}
+
+/// Project a rectangle on the virtual surface into the visible pane area.
+pub(super) fn project_rect(rect: Rect, area: Rect, offset: u16) -> Rect {
+    let clipped = rect.intersection(Rect::new(offset, 0, area.width, area.height));
+    if clipped.is_empty() {
+        return Rect::default();
+    }
+    Rect::new(
+        area.x + clipped.x - offset,
+        area.y + clipped.y,
+        clipped.width,
+        clipped.height,
+    )
+}
+
+impl SlidingPanes {
+    pub(super) fn reset_reveal(&mut self) {
+        self.reveal_key = None;
+    }
+}
+
+impl PaneHit {
+    pub(super) fn pane_col(&self, screen_col: u16) -> u16 {
+        screen_col
+            .saturating_sub(self.inner_rect.x)
+            .saturating_add(self.source_col)
+    }
+
+    pub(super) fn project_terminal_rect(&self, rect: Rect) -> Rect {
+        project_rect(rect, self.inner_rect, self.source_col)
+    }
+}
+
+impl ClientShellState {
+    pub(crate) fn sliding_panes_enabled(&self) -> bool {
+        self.sliding.enabled
+    }
+
+    pub(super) fn toggle_sliding_panes(&mut self, outcome: &mut ClientShellInput) {
+        self.sliding.enabled = !self.sliding.enabled;
+        self.sliding.offset = 0;
+        self.sliding.reveal_key = None;
+        self.exit_copy_mode(false, outcome);
+        self.selection = None;
+        self.word_selection_gesture = None;
+        self.pane_mouse_gesture = None;
+        self.chrome_drag = None;
+        self.stop_selection_autoscroll();
+        self.invalidate_pane_surface();
+        self.persist_chrome_preferences(outcome);
+        outcome.resize = true;
+        outcome.repaint = true;
+    }
+
+    pub(super) fn sliding_surface_columns(&self, area: Rect) -> u16 {
+        if !self.sliding.enabled {
+            return area.width.max(1);
+        }
+        let count = self.snapshot.as_deref().map_or(1, |snapshot| {
+            if snapshot.tabs.iter().any(|tab| tab.focused && tab.zoomed) {
+                return 1;
+            }
+            snapshot
+                .panes
+                .iter()
+                .filter(|pane| Some(&pane.tab_id) == snapshot.focused_tab_id.as_ref())
+                .count()
+                .max(1)
+        });
+        // Stay within the existing endpoint's geometry limits, including tall windows.
+        let limit = (1_000_000 / u32::from(area.height.max(1))).min(4096) as u16;
+        if count == 1 {
+            return area.width.max(1);
+        }
+        area.width
+            .max(PANE_COLUMNS.saturating_mul(count.min(4096) as u16))
+            .min(limit)
+            .max(1)
+    }
+
+    pub(super) fn update_sliding_viewport(&mut self, area: Rect) {
+        if !self.sliding.enabled {
+            self.sliding.offset = 0;
+            return;
+        }
+        let Some(surface) = self.pane_surface.as_ref() else {
+            return;
+        };
+        let max = surface.frame.width.saturating_sub(area.width);
+        self.sliding.offset = self.sliding.offset.min(max);
+        let Some(pane) = surface.panes.iter().find(|pane| pane.focused) else {
+            return;
+        };
+        let rect = Rect::new(pane.rect.x, pane.rect.y, pane.rect.width, pane.rect.height);
+        let key = (
+            self.active_endpoint_id.clone(),
+            pane.pane_id.clone(),
+            // Split-ratio changes must not scroll the viewport under a drag,
+            // including the final server frame arriving after mouse release.
+            surface.frame.width,
+            area.width,
+        );
+        if self.sliding.reveal_key.as_ref() == Some(&key) {
+            return;
+        }
+        self.sliding.reveal_key = Some(key);
+        if rect.x < self.sliding.offset || rect.width > area.width {
+            self.sliding.offset = rect.x.min(max);
+        } else if rect.right() > self.sliding.offset.saturating_add(area.width) {
+            self.sliding.offset = rect.right().saturating_sub(area.width).min(max);
+        }
+    }
+
+    pub(super) fn sliding_bar(&self, area: Rect) -> Rect {
+        if self.sliding.enabled {
+            Rect::new(area.x, area.bottom(), area.width, 1)
+        } else {
+            Rect::default()
+        }
+    }
+
+    fn sliding_location_info(&self, area: Rect) -> (String, String) {
+        let total_cols = self
+            .pane_surface
+            .as_ref()
+            .map_or(area.width, |surface| surface.frame.width);
+        let max = total_cols.saturating_sub(area.width);
+        let pct = if max > 0 {
+            (u32::from(self.sliding.offset) * 100 / u32::from(max)) as u16
+        } else {
+            0
+        };
+        let pct_str = format!(" {}% ", pct);
+
+        let Some(surface) = self.pane_surface.as_ref() else {
+            return (format!(" ‹ SLIDE {}% › ", pct), pct_str);
+        };
+
+        let mut sorted_panes = surface.panes.iter().collect::<Vec<_>>();
+        sorted_panes.sort_by_key(|p| (p.rect.x, p.rect.y));
+        let total_panes = sorted_panes.len();
+        if total_panes <= 1 {
+            return (format!(" ‹ SLIDE 1/1 ({}%) › ", pct), pct_str);
+        }
+
+        let viewport_start = self.sliding.offset;
+        let viewport_end = self.sliding.offset.saturating_add(area.width);
+
+        let mut first_vis = 0;
+        let mut last_vis = 0;
+        let mut focused_info = None;
+
+        for (idx, p) in sorted_panes.iter().enumerate() {
+            let pane_num = idx + 1;
+            let p_start = p.rect.x;
+            let p_end = p.rect.x.saturating_add(p.rect.width);
+            if p_start < viewport_end && p_end > viewport_start {
+                if first_vis == 0 {
+                    first_vis = pane_num;
+                }
+                last_vis = pane_num;
+            }
+            if p.focused {
+                let name = self.snapshot.as_deref().and_then(|snap| {
+                    snap.agents
+                        .iter()
+                        .find(|a| a.pane_id == p.pane_id)
+                        .and_then(|a| {
+                            a.name
+                                .as_deref()
+                                .or(a.display_agent.as_deref())
+                                .or(a.title.as_deref())
+                        })
+                        .or_else(|| {
+                            snap.panes
+                                .iter()
+                                .find(|sp| sp.pane_id == p.pane_id)
+                                .and_then(|sp| sp.label.as_deref())
+                        })
+                });
+                focused_info = Some((pane_num, name.unwrap_or("").to_string()));
+            }
+        }
+
+        let first_vis = first_vis.max(1);
+        let last_vis = last_vis.max(first_vis);
+        let panes_str = if first_vis == last_vis {
+            format!("Pane {first_vis}/{total_panes}")
+        } else {
+            format!("Panes {first_vis}-{last_vis}/{total_panes}")
+        };
+
+        let focus_str = focused_info.map(|(num, name)| {
+            if !name.is_empty() {
+                format!("Focus #{num}: {name}")
+            } else {
+                format!("Focus #{num}")
+            }
+        });
+
+        let label = if let Some(focus) = focus_str {
+            if area.width >= 70 {
+                format!(" ‹ SLIDE › {} | {} ", panes_str, focus)
+            } else {
+                format!(" ‹ SLIDE › {} ", panes_str)
+            }
+        } else {
+            format!(" ‹ SLIDE › {} ", panes_str)
+        };
+
+        (label, pct_str)
+    }
+
+    fn resolve_pane_badge(&self, pane_id: &str) -> String {
+        let Some(snap) = self.snapshot.as_deref() else {
+            return String::new();
+        };
+
+        // 1. Check snapshot.agents
+        if let Some(agent) = snap.agents.iter().find(|a| a.pane_id == pane_id) {
+            if let Some(canonical) = agent
+                .agent
+                .as_deref()
+                .and_then(crate::detect::parse_agent_label)
+            {
+                return match canonical {
+                    crate::detect::Agent::Antigravity => "AGY".into(),
+                    crate::detect::Agent::Hermes => "Hermes".into(),
+                    crate::detect::Agent::Claude => "Claude".into(),
+                    crate::detect::Agent::Codex => "Codex".into(),
+                    crate::detect::Agent::Gemini => "Gemini".into(),
+                    crate::detect::Agent::OpenCode => "OpenCode".into(),
+                    crate::detect::Agent::Cursor => "Cursor".into(),
+                    crate::detect::Agent::Kiro => "Kiro".into(),
+                    crate::detect::Agent::Kilo => "Kilo".into(),
+                    crate::detect::Agent::Devin => "Devin".into(),
+                    crate::detect::Agent::Pi => "Pi".into(),
+                    other => format!("{other:?}"),
+                };
+            }
+            if let Some(name) = agent.display_agent.as_deref().or(agent.name.as_deref()) {
+                let lower = name.to_lowercase();
+                if lower.contains("agy") || lower.contains("antigravity") {
+                    return "AGY".into();
+                } else if lower.contains("hermes") {
+                    return "Hermes".into();
+                } else if lower.contains("claude") {
+                    return "Claude".into();
+                } else if lower.contains("codex") {
+                    return "Codex".into();
+                } else if lower.contains("gemini") {
+                    return "Gemini".into();
+                } else if lower.contains("opencode") {
+                    return "OpenCode".into();
+                }
+                return name.chars().take(7).collect();
+            }
+        }
+
+        // 2. Check snapshot.panes label
+        if let Some(pane) = snap.panes.iter().find(|p| p.pane_id == pane_id) {
+            if let Some(label) = pane.label.as_deref() {
+                let lower = label.to_lowercase();
+                if lower.contains("agy") || lower.contains("antigravity") {
+                    return "AGY".into();
+                } else if lower.contains("hermes") {
+                    return "Hermes".into();
+                } else if lower.contains("claude") {
+                    return "Claude".into();
+                } else if lower.contains("codex") {
+                    return "Codex".into();
+                } else if lower.contains("gemini") {
+                    return "Gemini".into();
+                } else if lower.contains("preview") {
+                    return "Preview".into();
+                } else if !label.is_empty() {
+                    let word = label.split_whitespace().next().unwrap_or(label);
+                    return word.chars().take(7).collect();
+                }
+            }
+        }
+
+        String::new()
+    }
+
+    pub(super) fn render_sliding_bar(&self, buffer: &mut Buffer, area: Rect) {
+        let bar = self.sliding_bar(area).intersection(buffer.area);
+        if bar.is_empty() {
+            return;
+        }
+        let total_cols = self
+            .pane_surface
+            .as_ref()
+            .map_or(area.width, |surface| surface.frame.width);
+        let max = total_cols.saturating_sub(area.width);
+        let (label, pct_str) = self.sliding_location_info(area);
+        buffer.set_style(
+            bar,
+            Style::default()
+                .fg(self.config.palette.overlay0)
+                .bg(self.config.palette.panel_bg),
+        );
+        let label_width = label.len().min(usize::from(bar.width)) as u16;
+        let pct_width = pct_str
+            .len()
+            .min(usize::from(bar.width.saturating_sub(label_width))) as u16;
+
+        let thumb_color = match self.config.palette.accent {
+            Color::Blue => Color::Cyan,
+            Color::Reset => Color::Cyan,
+            other => other,
+        };
+
+        buffer.set_stringn(
+            bar.x,
+            bar.y,
+            &label,
+            usize::from(label_width),
+            Style::default()
+                .fg(thumb_color)
+                .add_modifier(Modifier::BOLD),
+        );
+
+        let track_start = bar.x.saturating_add(label_width);
+        let track_end = bar.right().saturating_sub(pct_width);
+
+        if pct_width > 0 && track_end < bar.right() {
+            buffer.set_stringn(
+                track_end,
+                bar.y,
+                &pct_str,
+                usize::from(pct_width),
+                Style::default()
+                    .fg(thumb_color)
+                    .add_modifier(Modifier::BOLD),
+            );
+        }
+
+        let track_width = track_end.saturating_sub(track_start);
+        if track_width >= 4 && max > 0 {
+            let rail_color = match self.config.palette.surface1 {
+                Color::Reset => Color::DarkGray,
+                other => other,
+            };
+            let rail_style = Style::default().fg(rail_color);
+            let thumb_style = Style::default()
+                .fg(thumb_color)
+                .add_modifier(Modifier::BOLD);
+
+            let thumb_len = (u32::from(area.width) * u32::from(track_width)
+                / u32::from(total_cols.max(1)))
+            .clamp(3, u32::from(track_width)) as u16;
+            let movable = track_width.saturating_sub(thumb_len);
+            let thumb_offset =
+                (u32::from(self.sliding.offset) * u32::from(movable) / u32::from(max)) as u16;
+            let thumb_start = track_start.saturating_add(thumb_offset);
+            let thumb_end = thumb_start.saturating_add(thumb_len).min(track_end);
+
+            let mut sorted_panes = self
+                .pane_surface
+                .as_ref()
+                .map(|s| s.panes.iter().collect::<Vec<_>>())
+                .unwrap_or_default();
+            sorted_panes.sort_by_key(|p| (p.rect.x, p.rect.y));
+            let total_panes = sorted_panes.len();
+
+            let mut track_chars: Vec<Option<char>> = vec![None; usize::from(track_width)];
+            let mut track_is_badge: Vec<bool> = vec![false; usize::from(track_width)];
+            let mut track_is_focused: Vec<bool> = vec![false; usize::from(track_width)];
+
+            let spacing = usize::from(track_width) / total_panes.max(1);
+            let mut prev_badge_end: usize = 0;
+
+            for (idx, p) in sorted_panes.iter().enumerate() {
+                let pane_num = idx + 1;
+                let mid_col = p.rect.x.saturating_add(p.rect.width / 2);
+                let target_pos = (u32::from(mid_col) * u32::from(track_width)
+                    / u32::from(total_cols.max(1))) as usize;
+                let badge_name = self.resolve_pane_badge(&p.pane_id);
+
+                let text = if spacing >= 9 && !badge_name.is_empty() {
+                    let short_name: String = badge_name.chars().take(7).collect();
+                    format!("[{pane_num}:{short_name}]")
+                } else if spacing >= 6 && !badge_name.is_empty() {
+                    let short_name: String = badge_name.chars().take(4).collect();
+                    format!("{pane_num}:{short_name}")
+                } else if spacing >= 4 {
+                    format!("[{pane_num}]")
+                } else {
+                    format!("{pane_num}")
+                };
+
+                let text_len = text.len();
+                let desired_start = target_pos.saturating_sub(text_len / 2);
+                let start = desired_start.max(prev_badge_end);
+
+                if start + text_len <= usize::from(track_width) {
+                    for (c_i, ch) in text.chars().enumerate() {
+                        let col_idx = start + c_i;
+                        track_chars[col_idx] = Some(ch);
+                        track_is_badge[col_idx] = true;
+                        if p.focused {
+                            track_is_focused[col_idx] = true;
+                        }
+                    }
+                    prev_badge_end = start + text_len + 1;
+                }
+            }
+
+            let thumb_start_idx = usize::from(thumb_start.saturating_sub(track_start));
+            let thumb_end_idx = usize::from(thumb_end.saturating_sub(track_start));
+
+            for col_idx in 0..usize::from(track_width) {
+                let screen_col = track_start.saturating_add(col_idx as u16);
+                let in_thumb = col_idx >= thumb_start_idx && col_idx < thumb_end_idx;
+                let is_focused = track_is_focused[col_idx];
+
+                if let Some(ch) = track_chars[col_idx] {
+                    let mut s = [0u8; 4];
+                    let ch_str = ch.encode_utf8(&mut s);
+                    let style = if in_thumb {
+                        if is_focused {
+                            Style::default()
+                                .fg(Color::Yellow)
+                                .bg(self.config.palette.surface0)
+                                .add_modifier(Modifier::BOLD | Modifier::UNDERLINED)
+                        } else {
+                            Style::default()
+                                .fg(Color::Cyan)
+                                .bg(self.config.palette.surface0)
+                                .add_modifier(Modifier::BOLD)
+                        }
+                    } else if is_focused {
+                        Style::default()
+                            .fg(Color::Yellow)
+                            .add_modifier(Modifier::BOLD | Modifier::UNDERLINED)
+                    } else if ch == '[' || ch == ']' {
+                        Style::default().fg(Color::DarkGray)
+                    } else {
+                        Style::default()
+                            .fg(Color::White)
+                            .add_modifier(Modifier::BOLD)
+                    };
+                    buffer[(screen_col, bar.y)]
+                        .set_symbol(ch_str)
+                        .set_style(style);
+                } else if in_thumb {
+                    let symbol = if col_idx == thumb_start_idx {
+                        "["
+                    } else if col_idx == thumb_end_idx.saturating_sub(1) {
+                        "]"
+                    } else {
+                        "█"
+                    };
+                    buffer[(screen_col, bar.y)]
+                        .set_symbol(symbol)
+                        .set_style(thumb_style);
+                } else {
+                    buffer[(screen_col, bar.y)]
+                        .set_symbol("─")
+                        .set_style(rail_style);
+                }
+            }
+        }
+    }
+
+    pub(super) fn handle_sliding_mouse(
+        &mut self,
+        mouse: MouseEvent,
+        outcome: &mut ClientShellInput,
+    ) -> bool {
+        if !self.sliding.enabled
+            || self.overlay.is_some()
+            || self.popup_terminal_id.is_some()
+            || self.popup_pending
+            || self.pane_mouse_gesture.is_some()
+            || self.chrome_drag.is_some()
+        {
+            return false;
+        }
+        let Some((cols, rows)) = self.last_composed_size else {
+            return false;
+        };
+        let area = self.layout(cols, rows).pane_surface;
+        let bar = self.sliding_bar(area);
+        let point = (mouse.column, mouse.row);
+        let on_bar = contains(bar, point);
+        if !on_bar && !contains(area, point) {
+            return false;
+        }
+        let shifted = mouse.modifiers.contains(KeyModifiers::SHIFT);
+        let delta = match mouse.kind {
+            MouseEventKind::ScrollLeft => -SCROLL_COLUMNS,
+            MouseEventKind::ScrollRight => SCROLL_COLUMNS,
+            MouseEventKind::ScrollUp if shifted || on_bar => -SCROLL_COLUMNS,
+            MouseEventKind::ScrollDown if shifted || on_bar => SCROLL_COLUMNS,
+            MouseEventKind::Down(crossterm::event::MouseButton::Left) if on_bar => {
+                let total_cols = self
+                    .pane_surface
+                    .as_ref()
+                    .map_or(area.width, |surface| surface.frame.width);
+                let max = total_cols.saturating_sub(area.width);
+                let (label, pct_str) = self.sliding_location_info(area);
+                let label_width = label.len().min(usize::from(bar.width)) as u16;
+                let pct_width = pct_str
+                    .len()
+                    .min(usize::from(bar.width.saturating_sub(label_width)))
+                    as u16;
+
+                let track_start = bar.x.saturating_add(label_width);
+                let track_end = bar.right().saturating_sub(pct_width);
+                let track_width = track_end.saturating_sub(track_start);
+
+                if mouse.column >= track_start
+                    && mouse.column < track_end
+                    && track_width > 0
+                    && max > 0
+                {
+                    let thumb_len = (u32::from(area.width) * u32::from(track_width)
+                        / u32::from(total_cols.max(1)))
+                    .clamp(3, u32::from(track_width)) as u16;
+                    let movable = track_width.saturating_sub(thumb_len);
+                    let click_rel = mouse.column.saturating_sub(track_start).min(track_width);
+                    let target_offset = if movable > 0 {
+                        let target_movable = click_rel.saturating_sub(thumb_len / 2).min(movable);
+                        (u32::from(target_movable) * u32::from(max) / u32::from(movable)) as u16
+                    } else {
+                        0
+                    };
+                    i32::from(target_offset) - i32::from(self.sliding.offset)
+                } else if mouse.column < bar.x + label_width / 2 {
+                    -i32::from(area.width / 2)
+                } else {
+                    i32::from(area.width / 2)
+                }
+            }
+            _ => return false,
+        };
+        let max = self
+            .pane_surface
+            .as_ref()
+            .map_or(0, |surface| surface.frame.width.saturating_sub(area.width));
+        let offset = (i32::from(self.sliding.offset) + delta).clamp(0, i32::from(max)) as u16;
+        if offset != self.sliding.offset {
+            self.sliding.offset = offset;
+            self.selection = None;
+            self.word_selection_gesture = None;
+            self.stop_selection_autoscroll();
+            self.clear_link_hover();
+            outcome.repaint = true;
+        }
+        true
+    }
+}
