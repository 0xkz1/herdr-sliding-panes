+#[test]
+fn sliding_split_drag_keeps_virtual_ratios_and_viewport_after_resize() {
+    use crate::protocol::{PaneSurfaceSplit, PaneSurfaceSplitDirection, SurfaceRect};
+
+    for direction in [
+        PaneSurfaceSplitDirection::Horizontal,
+        PaneSurfaceSplitDirection::Vertical,
+    ] {
+        let mut state = sliding_state();
+        state.sliding.offset = 64;
+        let horizontal = direction == PaneSurfaceSplitDirection::Horizontal;
+        let surface = state.pane_surface.as_mut().expect("surface");
+        surface.splits.push(PaneSurfaceSplit {
+            direction,
+            pos: if horizontal { 120 } else { 5 },
+            area: SurfaceRect {
+                x: 40,
+                y: 2,
+                width: 160,
+                height: 8,
+            },
+            hit_rect: if horizontal {
+                SurfaceRect {
+                    x: 120,
+                    y: 2,
+                    width: 1,
+                    height: 8,
+                }
+            } else {
+                SurfaceRect {
+                    x: 40,
+                    y: 5,
+                    width: 160,
+                    height: 1,
+                }
+            },
+            path: vec![false, true],
+        });
+        // A divider outside the viewport must not intercept clicks at its old position.
+        surface.splits.push(PaneSurfaceSplit {
+            direction: PaneSurfaceSplitDirection::Horizontal,
+            pos: 40,
+            area: SurfaceRect {
+                x: 0,
+                y: 0,
+                width: 80,
+                height: 10,
+            },
+            hit_rect: SurfaceRect {
+                x: 40,
+                y: 0,
+                width: 1,
+                height: 10,
+            },
+            path: vec![true],
+        });
+        state.compose(80, 20).expect("scrolled split surface");
+        assert_eq!(state.hits.pane_splits.len(), 1);
+        let split = state.hits.pane_splits[0].clone();
+        let area = state.layout(80, 20).pane_surface;
+        assert_eq!(split.hit_rect.x, area.x + if horizontal { 56 } else { 0 });
+        let mut event = MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: split.hit_rect.x,
+            row: split.hit_rect.y,
+            modifiers: KeyModifiers::empty(),
+        };
+        state.handle_raw_events(vec![RawInputEvent::Mouse(event)]);
+        assert!(matches!(
+            state.chrome_drag,
+            Some(ClientChromeDrag::PaneSplit { .. })
+        ));
+        event.kind = MouseEventKind::Drag(MouseButton::Left);
+        if horizontal {
+            event.column += 16;
+        } else {
+            event.row += 1;
+        }
+        let drag = state.handle_raw_events(vec![RawInputEvent::Mouse(event)]);
+        let expected = if horizontal { 0.6 } else { 0.5 };
+        assert!(matches!(
+            &drag.actions[..],
+            [ClientShellAction::Endpoint { request, .. }]
+                if matches!(&request.method,
+                    crate::api::schema::Method::LayoutSetSplitRatio(params)
+                        if params.tab_id.as_deref() == Some("tab_1")
+                            && params.path == vec![false, true]
+                            && (params.ratio - expected).abs() < f32::EPSILON)
+        ));
+        // Server frames can arrive during the gesture and after the final release.
+        state.pane_surface.as_mut().expect("surface").panes[0]
+            .rect
+            .width += 1;
+        state.compose(80, 20).expect("resize while dragging");
+        assert_eq!(state.sliding.offset, 64);
+        event.kind = MouseEventKind::Up(MouseButton::Left);
+        if horizontal {
+            event.column += 8;
+        } else {
+            event.row += 1;
+        }
+        let release = state.handle_raw_events(vec![RawInputEvent::Mouse(event)]);
+        let final_ratio = if horizontal { 0.65 } else { 0.625 };
+        assert!(matches!(
+            &release.actions[..],
+            [ClientShellAction::Endpoint { request, .. }]
+                if matches!(&request.method,
+                    crate::api::schema::Method::LayoutSetSplitRatio(params)
+                        if (params.ratio - final_ratio).abs() < f32::EPSILON)
+        ));
+        assert!(state.chrome_drag.is_none());
+        state.pane_surface.as_mut().expect("surface").panes[0]
+            .rect
+            .width += 1;
+        state.compose(80, 20).expect("resize after release");
+        assert_eq!(state.sliding.offset, 64);
+    }
+}
