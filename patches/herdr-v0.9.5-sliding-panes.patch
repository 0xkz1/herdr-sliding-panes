+#[test]
+fn sliding_focus_reveals_pane_but_wheel_can_move_away_and_clamps() {
+    let mut state = sliding_state();
+    state.pane_surface.as_mut().expect("surface").panes[0].focused = false;
+    state.pane_surface.as_mut().expect("surface").panes[2].focused = true;
+    let frame = state.compose(80, 20).expect("focus frame");
+    assert_eq!(state.sliding.offset, 160);
+    let area = state.layout(80, 20).pane_surface;
+    assert_eq!(frame.frame.cells[usize::from(area.y) * 80].symbol, "C");
+    assert_eq!(state.hits.panes.len(), 1);
+    let event = mouse(&state, MouseEventKind::ScrollLeft, 1);
+    let moved = state.handle_raw_events(vec![event]);
+    assert!(moved.repaint);
+    assert!(moved.requests.is_empty() && moved.actions.is_empty());
+    state.compose(80, 20).expect("scroll frame");
+    assert_eq!(state.sliding.offset, 152);
+    for _ in 0..40 {
+        let event = mouse(&state, MouseEventKind::ScrollLeft, 1);
+        state.handle_raw_events(vec![event]);
+    }
+    assert_eq!(state.sliding.offset, 0);
+}
