+#[test]
+fn sliding_bar_track_and_click_jump() {
+    let mut state = sliding_state();
+    assert!(state.sliding_panes_enabled());
+    let frame = state.compose(80, 20).expect("frame");
+    let area = state.layout(80, 20).pane_surface;
+    let bar_y = area.bottom();
+
+    // Check that rail "─" and thumb "█" exist on the sliding bar row:
+    let row_start = usize::from(bar_y) * usize::from(frame.width);
+    let row_cells = &frame.cells[row_start..row_start + usize::from(frame.width)];
+    let has_track = row_cells.iter().any(|c| c.symbol == "─");
+    let has_thumb = row_cells.iter().any(|c| c.symbol == "█");
+    assert!(has_track, "sliding bar row should contain rail track");
+    assert!(has_thumb, "sliding bar row should contain thumb");
+
+    let row_str: String = row_cells.iter().map(|c| c.symbol.as_str()).collect();
+    assert!(
+        row_str.contains("Pane"),
