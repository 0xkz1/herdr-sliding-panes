+#[test]
+fn sliding_patch_crops_visible_rows_and_keeps_hidden_updates_fast() {
+    let mut state = sliding_state();
+    state.sliding.offset = 8;
+    state.compose(80, 20).expect("scrolled frame");
+    let current = state.pane_surface.as_ref().expect("surface");
+    let mut cells = current.frame.cells[..80].to_vec();
+    for cell in &mut cells {
+        cell.symbol = "Z".into();
+    }
+    let patch = crate::protocol::PaneSurfacePatch {
+        boot_id: current.boot_id.clone(),
+        projection_revision: current.projection_revision,
+        base_surface_revision: current.surface_revision,
+        surface_revision: current.surface_revision + 1,
+        rows: vec![crate::protocol::PaneSurfacePatchRow { x: 0, y: 1, cells }],
+        panes: vec![current.panes[0].clone()],
+        cursor: None,
+    };
+    let ClientPaneSurfacePatchOutcome::Applied(Some(patch)) = state.apply_pane_surface_patch(patch)
+    else {
+        panic!("fast patch");
+    };
+    assert_eq!(patch.rows[0].cells.len(), 72);
+    assert_eq!(patch.rows[0].x, 0);
+    state.sliding.offset = 160;
+    state.compose(80, 20).expect("hidden frame");
+    let current = state.pane_surface.as_ref().expect("surface");
+    let patch = crate::protocol::PaneSurfacePatch {
+        boot_id: current.boot_id.clone(),
+        projection_revision: current.projection_revision,
+        base_surface_revision: current.surface_revision,
+        surface_revision: current.surface_revision + 1,
+        rows: vec![crate::protocol::PaneSurfacePatchRow {
+            x: 0,
+            y: 1,
+            cells: current.frame.cells[80..160].to_vec(),
+        }],
+        panes: vec![current.panes[0].clone()],
+        cursor: None,
+    };
+    let ClientPaneSurfacePatchOutcome::Applied(Some(patch)) = state.apply_pane_surface_patch(patch)
+    else {
+        panic!("hidden fast patch");
+    };
+    assert!(patch.rows.is_empty());
+}
