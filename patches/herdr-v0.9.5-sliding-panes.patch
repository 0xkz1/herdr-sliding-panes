+/// Clip main-surface images to the horizontal viewport; popup geometry stays local.
+fn project_horizontal_placement(
+    placement: &SurfaceGraphicsPlacement,
+    offset: u16,
+    width: u16,
+    cell_size: HostCellSize,
+) -> Option<SurfaceGraphicsPlacement> {
+    if matches!(
+        placement.asset.source,
+        SurfaceGraphicsSource::Terminal {
+            target: SurfaceGraphicsTarget::Popup { .. },
+            ..
+        }
+    ) {
+        return Some(placement.clone());
+    }
+    let x = u32::from(placement.x);
+    let left = x.max(u32::from(offset));
+    let right = x
+        .saturating_add(placement.cols)
+        .min(u32::from(offset) + u32::from(width));
+    if left >= right || placement.cols == 0 {
+        return None;
+    }
+    let (start, source_width) = piece_source_span(
+        left - x,
+        right - left,
+        placement.cols,
+        cell_size.width_px,
+        placement.x_offset,
+        placement.source_width,
+    );
+    let mut clipped = placement.clone();
+    clipped.x = (left - u32::from(offset)) as u16;
+    clipped.cols = right - left;
+    clipped.source_x = clipped.source_x.saturating_add(start);
+    clipped.source_width = source_width;
+    if left != x {
+        clipped.x_offset = 0;
+    }
+    Some(clipped)
+}
