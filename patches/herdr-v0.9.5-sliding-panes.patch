+fn readable_split_rect(
+    area: Rect,
+    direction: Direction,
+    ratio: f32,
+    first: &Node,
+    second: &Node,
+) -> (Rect, Rect) {
+    let (mut a, mut b) = split_rect(area, direction, ratio);
+    if direction == Direction::Horizontal {
+        // ponytail: subtree scans are O(n²) for a skewed tree; cache floors
+        // only if pane-scaling benchmarks show this becomes material.
+        let min_a = readable_width(first);
+        let min_b = readable_width(second);
+        if u32::from(area.width) >= u32::from(min_a) + u32::from(min_b) {
+            a.width = a.width.clamp(min_a, area.width - min_b);
+            b.x = area.x + a.width;
+            b.width = area.width - a.width;
+        }
+    }
+    (a, b)
