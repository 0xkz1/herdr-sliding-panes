+use super::*;
+
+fn sliding_state() -> ClientShellState {
+    let mut config = Config::default();
+    config.ui.sidebar_start_collapsed = true;
+    config.ui.sidebar_collapsed_mode = SidebarCollapsedModeConfig::Hidden;
+    config.ui.mobile_width_threshold = 0;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.sliding.enabled = true;
+    let mut snapshot = snapshot();
+    let template = snapshot.panes[0].clone();
+    snapshot.panes = (1..=3)
+        .map(|index| ClientShellPane {
+            pane_id: format!("pane_{index}"),
+            focused: index == 1,
+            ..template.clone()
+        })
+        .collect();
+    state.set_snapshot(Box::new(snapshot));
+    let mut surface = surface();
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 240, 10));
+    for y in 0..10 {
+        for x in 0..240 {
+            buffer[(x, y)].set_symbol(match x / 80 {
+                0 => "A",
+                1 => "B",
+                _ => "C",
+            });
+        }
+    }
+    surface.frame = FrameData::from_ratatui_buffer_with_hyperlinks(&buffer, None, &[]);
+    let template = surface.panes[0].clone();
+    surface.panes = (0..3)
+        .map(|index| PaneSurfacePane {
+            pane_id: format!("pane_{}", index + 1),
+            rect: SurfaceRect {
+                x: index * 80,
+                y: 0,
+                width: 80,
+                height: 10,
+            },
+            inner_rect: SurfaceRect {
+                x: index * 80,
+                y: 0,
+                width: 80,
+                height: 10,
+            },
+            focused: index == 0,
+            scroll: Some(crate::protocol::PaneSurfaceScrollMetrics {
+                offset_from_bottom: 0,
+                max_offset_from_bottom: 10,
+                viewport_rows: 10,
+            }),
+            ..template.clone()
+        })
+        .collect();
+    state.set_pane_surface(surface);
+    state.compose(80, 20).expect("initial frame");
+    state
+}
+
+fn mouse(state: &ClientShellState, kind: MouseEventKind, col: u16) -> RawInputEvent {
+    let area = state.layout(80, 20).pane_surface;
+    RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: area.x + col,
+        row: area.y + 1,
+        modifiers: KeyModifiers::empty(),
+    })
+}
