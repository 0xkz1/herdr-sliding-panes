+// Reserve 45 text columns plus a gap, two border cells and a scrollbar gutter.
+const READABLE_PANE_COLUMNS: u16 = 49;
+
+fn readable_width(node: &Node) -> u16 {
+    match node {
+        Node::Pane(_) => READABLE_PANE_COLUMNS,
+        Node::Split {
+            direction,
+            first,
+            second,
+            ..
+        } => {
+            let a = readable_width(first);
+            let b = readable_width(second);
+            if *direction == Direction::Horizontal {
+                a.saturating_add(b)
+            } else {
+                a.max(b)
+            }
+        }
+    }
+}
