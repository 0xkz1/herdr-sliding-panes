+#[test]
+fn sliding_toggle_resizes_and_restores_default_geometry() {
+    let mut state = sliding_state();
+    assert_eq!(state.surface_size(80, 20).cols, 288);
+    let height = state.surface_size(80, 20).rows;
+    state.mode = ClientShellMode::Prefix;
+    let toggle = state.handle_input_bytes(b"S");
+    assert!(toggle.resize);
+    assert!(!state.sliding.enabled);
+    assert_eq!(
+        state.surface_size(80, 20),
+        ClientSurfaceSize {
+            cols: 80,
+            rows: height + 1
+        }
+    );
+    assert!(state.hits.panes.is_empty());
+}
