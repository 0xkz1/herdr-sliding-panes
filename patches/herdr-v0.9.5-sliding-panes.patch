+#[ignore = "manual sliding viewport scaling profile"]
+async fn sliding_render_scale_profile() {
+    let rows = CARDINALITIES.map(|count| {
+        let mut pipeline = RenderPipeline::new(active_panes(count));
+        pipeline.app.state.ensure_test_terminals();
+        let snapshot = super::client_shell::snapshot(&pipeline.app, "bench-boot", 1, None, None);
+        assert_eq!(
+            snapshot.panes.len(),
+            count,
+            "profile requires populated pane identities"
+        );
+        pipeline.client.set_snapshot(Box::new(snapshot));
+        assert!(pipeline.client.handle_input_bytes(b"\x02S").resize);
+        let width = pipeline.client.surface_size(COLS, ROWS).cols;
+        assert!(
+            count == 1 || width >= (count as u16).saturating_mul(96).min(4096),
+            "sliding fixture did not expand for {count} panes: {width} columns"
+        );
+        (count, profile_pipeline(pipeline))
+    });
+    println!("sliding active panes at {COLS}x{ROWS} host geometry");
+    print_stage("server pane surface", &rows, |stats| stats.server);
+    print_stage("client shell composition", &rows, |stats| stats.client);
+    print_stage("combined pipeline", &rows, |stats| stats.total);
+}
